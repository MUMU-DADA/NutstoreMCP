# 坚果云 WebDAV 凭据
# 账号 = 登录邮箱；密码 = 网页端「账户信息 → 安全选项 → 第三方应用管理」生成的**应用密码**
# 注意：不是登录密码。生成步骤见 https://help.jianguoyun.com/?p=2064
NUTSTORE_USER=your-email@example.com
NUTSTORE_PASS=your-app-password

# WebDAV 端点（企业私有部署才需要改）
# NUTSTORE_HOST=https://dav.jianguoyun.com/dav/

# ---- 护栏（见 ARCHITECTURE.md 第 5 节）----

# 路径白名单：只允许访问这些云端根目录下的内容，逗号分隔。
# **留空 = 拒绝一切访问**（fail-closed，不是放行一切）。
NUTSTORE_ROOTS=我的坚果云

# 只读模式：true 时所有写工具（上传/建目录/移动/删除）直接拒绝。
# 建议长期保持 true，需要写时单次显式开启。
NUTSTORE_READ_ONLY=true

# 请求预算：WebDAV 官方限制为 600 次/30 分钟（免费）/ 1500（付费）。
# 客户端按此自我限流，避免把配额烧光。
NUTSTORE_RATE_LIMIT=600
NUTSTORE_RATE_WINDOW_MS=1800000

# 单文件上传上限（字节）。官方限制 500MB。
NUTSTORE_MAX_UPLOAD_BYTES=524288000

# 本地坚果云数据目录（一般不用改）
# NUTSTORE_DATA_DIR=%APPDATA%\Nutstore
