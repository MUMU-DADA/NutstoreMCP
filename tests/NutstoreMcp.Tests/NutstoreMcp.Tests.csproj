<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xunit v3 + Microsoft.Testing.Platform：测试在自身进程内运行。
         不用 VSTest 的独立 testhost —— 它启动时会 OpenProcess 父进程来监听退出，
         在装了 HIPS/安全软件的机器上会被拒绝访问（实测 Win32Exception 5）。 -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- L3 的安全逻辑是纯函数、不依赖客户端也不依赖 WPF，所以直接链接源码进来测。

       必须链接的理由：这两个文件原先只有 recon/UiHookProbe 覆盖，而那个项目
       不在解决方案里、dotnet test 也不跑它 —— 结果是跑测试看到 90/90 全绿，
       却完全不知道「非空目录必拒」这条最重要的规则根本没被验证。
       安全关键逻辑不能在 CI 视野之外。 -->
  <ItemGroup>
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\WriteGuards.cs" Link="L3\WriteGuards.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\ForbiddenClientMethods.cs" Link="L3\ForbiddenClientMethods.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\CloudFolderName.cs" Link="L3\CloudFolderName.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\SettableSettings.cs" Link="L3\SettableSettings.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\ClientCallSites.cs" Link="L3\ClientCallSites.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\CloudObjectPath.cs" Link="L3\CloudObjectPath.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\CloudWriteOperations.cs" Link="L3\CloudWriteOperations.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\LocalReadPolicy.cs" Link="L3\LocalReadPolicy.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\LocalDirectoryProbe.cs" Link="L3\LocalDirectoryProbe.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\CreatedObjectLedger.cs" Link="L3\CreatedObjectLedger.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\CreatedObjectDelete.cs" Link="L3\CreatedObjectDelete.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\FileModify.cs" Link="L3\FileModify.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\ShareLedger.cs" Link="L3\ShareLedger.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\SharePublish.cs" Link="L3\SharePublish.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\RemoteEventCodec.cs" Link="L3\RemoteEventCodec.cs" />
    <Compile Include="..\..\src\NutstoreMcp.Plugin\L3\CloudContentCodec.cs" Link="L3\CloudContentCodec.cs" />
    <Compile Include="..\..\src\NutstoreMcp.ClientBindings\ClientSymbols.cs" Link="ClientBindings\ClientSymbols.cs" />
  </ItemGroup>

</Project>
