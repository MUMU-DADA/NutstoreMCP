<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>nutstore-mcp</AssemblyName>
    <RootNamespace>NutstoreMcp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- 路径比较一律用 Ordinal，不依赖文化。关掉 ICU 让行为更可预测、体积更小。
         绝不能用文化敏感比较做路径或白名单判断（土耳其 I 问题等）。 -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 单文件自包含发布走命令行参数，不写在这里 ——
         否则 dotnet build / dotnet test 也会变慢。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <!-- 测试需要访问 ConnectionForTests（验证连接确实是只读的），
       但不想把这个仅供测试的口子暴露成 public API。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="NutstoreMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\NutstoreMcp.ClientBindings\ClientSymbols.cs" Link="ClientBindings\ClientSymbols.cs" />
  </ItemGroup>
</Project>
