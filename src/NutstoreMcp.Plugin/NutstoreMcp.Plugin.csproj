<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NutstoreMcp.Plugin</AssemblyName>
    <RootNamespace>NutstoreMcp.Plugin</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- 关键：插件必须跑在自己的 AppDomain 里，并带自己的绑定重定向。
         原因：插件依赖 System.Memory 4.0.5.0 / Microsoft.Extensions.* 10.x，
         而 NutstoreClient.exe.config 已经把 System.Memory 重定向到 4.0.2.0。
         同域加载会二选一 —— 要么插件崩，要么客户端自己的代码崩。
         独立 AppDomain + 独立 ConfigurationFile 让两边版本互不干扰，
         顺带还能卸载重载（改插件不必重启客户端）。 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AppConfig>app.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NutstoreMcp.Plugin.Contract\NutstoreMcp.Plugin.Contract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <!-- WPF 类型：设置界面注入要用。由宿主进程提供，不复制到输出目录。 -->
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
