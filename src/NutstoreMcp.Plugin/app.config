<?xml version="1.0" encoding="utf-8"?>
<!--
  插件自己 AppDomain 的配置文件。

  MSBuild 处理后以 NutstoreMcp.Plugin.dll.config 输出到插件目录，
  由宿主在 AppDomainSetup.ConfigurationFile 里指定。

  为什么必须有：客户端进程的 NutstoreClient.exe.config 已经把
  System.Memory 重定向到 4.0.2.0，而插件依赖 4.0.5.0。同域加载时
  两者只能活一个。独立配置把插件的依赖版本和客户端隔开。

  <runtime> 里的 assemblyBinding 由 MSBuild 按实际依赖图自动填充
  （AutoGenerateBindingRedirects），这里不手写。
-->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" />
  </runtime>
</configuration>
